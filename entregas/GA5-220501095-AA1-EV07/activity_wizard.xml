<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F3F4">

    <!-- HEADER: Título e indicación de paso -->
    <RelativeLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#FFFFFF"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerVertical="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agenda de Citas"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2C1A1E" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestión de disponibilidad y reservas"
                android:textSize="11sp"
                android:textColor="#8A3F52" />
        </LinearLayout>
    </RelativeLayout>

    <!-- CONTENT: Real Citas fields and slot selection -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. FILTROS DE AGENDA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FILTRAR AGENDA"
                android:textColor="#6B4A52"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <!-- Fecha -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fecha de Consulta"
                    android:textSize="11sp"
                    android:textColor="#4A4A4A"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etConsultaDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="date"
                    android:text="2026-07-27"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <!-- Servicio dropdown -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Servicio"
                    android:textSize="11sp"
                    android:textColor="#4A4A4A"
                    android:textStyle="bold" />
                <Spinner
                    android:id="@+id/spinnerService"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" />

                <!-- Empleado dropdown -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Empleado (Profesional)"
                    android:textSize="11sp"
                    android:textColor="#4A4A4A"
                    android:textStyle="bold" />
                <Spinner
                    android:id="@+id/spinnerEmployee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 2. GRID DE DISPONIBILIDAD (SLOTS) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HORARIOS DISPONIBLES"
                android:textColor="#6B4A52"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <!-- Fila 1 de slots -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <Button
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="09:00 AM"
                        android:textSize="11sp"
                        android:textColor="#8A3F52"
                        android:background="#F3E8EB"
                        android:layout_marginEnd="4dp" />
                    <Button
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="10:00 AM"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"
                        android:background="#8A3F52"
                        android:layout_marginHorizontal="2dp" />
                    <Button
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="11:30 AM"
                        android:textSize="11sp"
                        android:textColor="#8A3F52"
                        android:background="#F3E8EB"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <!-- Fila 2 de slots -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="01:00 PM"
                        android:textSize="11sp"
                        android:textColor="#8A3F52"
                        android:background="#F3E8EB"
                        android:layout_marginEnd="4dp" />
                    <Button
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="02:30 PM"
                        android:textSize="11sp"
                        android:textColor="#8A3F52"
                        android:background="#F3E8EB"
                        android:layout_marginHorizontal="2dp" />
                    <Button
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="04:00 PM"
                        android:textSize="11sp"
                        android:textColor="#8A3F52"
                        android:background="#F3E8EB"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. FORMULARIO DE AGENDAMIENTO RÁPIDO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATOS DEL CLIENTE"
                android:textColor="#6B4A52"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <!-- Nombre -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre del Cliente"
                    android:textSize="11sp"
                    android:textColor="#4A4A4A"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etClientName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:hint="Ej. Pedro Ramirez"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <!-- Documento -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Documento de Identidad"
                    android:textSize="11sp"
                    android:textColor="#4A4A4A"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etClientDoc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:hint="Ej. 10203040"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <!-- Teléfono -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Número Telefónico"
                    android:textSize="11sp"
                    android:textColor="#4A4A4A"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etClientPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:hint="Ej. 3001234567"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnConfirmBooking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Confirmar Reserva"
                    android:textColor="#FFFFFF"
                    android:background="#8A3F52" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- FOOTER Navigation -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_home" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textSize="10sp"
                android:textColor="#9E7A85" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_my_calendar" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agenda Citas"
                android:textSize="10sp"
                android:textColor="#8A3F52" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_preferences" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seguridad"
                android:textSize="10sp"
                android:textColor="#9E7A85" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
