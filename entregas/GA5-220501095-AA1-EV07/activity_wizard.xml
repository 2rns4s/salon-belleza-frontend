<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F3F4"
    tools:context=".BookingWizardActivity">

    <!-- HEADER: Título e indicación de paso -->
    <RelativeLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="16dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerVertical="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agendar Cita"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2C1A1E" />

            <TextView
                android:id="@+id/tvStepIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paso 1 de 3"
                android:textSize="12sp"
                android:textColor="#8A3F52" />
        </LinearLayout>
    </RelativeLayout>

    <!-- WIZARD STEP INDICATOR BAR -->
    <LinearLayout
        android:id="@+id/layoutProgress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Paso 1 -->
        <TextView
            android:id="@+id/indicatorStep1"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_circle_active"
            android:gravity="center"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />

        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:background="#8A3F52"
            android:layout_gravity="center_vertical" />

        <!-- Paso 2 -->
        <TextView
            android:id="@+id/indicatorStep2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_circle_inactive"
            android:gravity="center"
            android:text="2"
            android:textColor="#9E7A85"
            android:textStyle="bold"
            android:textSize="12sp" />

        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:background="#EADDE0"
            android:layout_gravity="center_vertical" />

        <!-- Paso 3 -->
        <TextView
            android:id="@+id/indicatorStep3"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_circle_inactive"
            android:gravity="center"
            android:text="3"
            android:textColor="#9E7A85"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- DINAMIC STEP CONTENT CONTAINER -->
    <FrameLayout
        android:id="@+id/stepContentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/layoutProgress"
        app:layout_constraintBottom_toTopOf="@id/layoutNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- A modo ilustrativo se muestra el Paso 1 (Lista de servicios) en la previsualización XML -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvServices"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:listitem="@layout/item_service" />
            
        <!-- Paso 2 (Calendar horizontal swipe y Horas grid) - Se infla dinámicamente -->
        <!-- Paso 3 (Confirmación) - Se infla dinámicamente -->
    </FrameLayout>

    <!-- FLOATING ACTION BUTTON (Paso 3): Confirmar Reserva -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabConfirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:src="@drawable/ic_check"
        android:backgroundTint="#8A3F52"
        app:tint="#FFFFFF"
        android:contentDescription="Confirmar Reserva"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <!-- NAVIGATION BUTTONS (Atrás y Continuar) -->
    <RelativeLayout
        android:id="@+id/layoutNavigation"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:text="Atrás"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="#8A3F52"/>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:text="Continuar"
            android:textColor="#FFFFFF"
            android:backgroundTint="#8A3F52"
            app:cornerRadius="8dp"/>
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
