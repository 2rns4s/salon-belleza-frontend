<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F3F4">

    <!-- HEADER: Título e indicación de paso -->
    <RelativeLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#FFFFFF"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerVertical="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agendar Cita"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2C1A1E" />

            <TextView
                android:id="@+id/tvStepIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paso 1 de 3: Seleccionar Servicio"
                android:textSize="12sp"
                android:textColor="#8A3F52" />
        </LinearLayout>
    </RelativeLayout>

    <!-- WIZARD STEP INDICATOR BAR -->
    <LinearLayout
        android:id="@+id/layoutProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_margin="16dp">

        <!-- Paso 1 -->
        <TextView
            android:id="@+id/indicatorStep1"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="#8A3F52"
            android:gravity="center"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />

        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:background="#8A3F52" />

        <!-- Paso 2 -->
        <TextView
            android:id="@+id/indicatorStep2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="#EADDE0"
            android:gravity="center"
            android:text="2"
            android:textColor="#9E7A85"
            android:textStyle="bold"
            android:textSize="12sp" />

        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:background="#EADDE0" />

        <!-- Paso 3 -->
        <TextView
            android:id="@+id/indicatorStep3"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="#EADDE0"
            android:gravity="center"
            android:text="3"
            android:textColor="#9E7A85"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- STEP CONTENT CONTAINER -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- PASO 1: Lista Vertical de Servicios -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERVICIOS DISPONIBLES"
                android:textColor="#6B4A52"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Servicio 1: Corte -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_edit" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Corte de Cabello"
                        android:textColor="#2C1A1E"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="45 min - $45.000"
                        android:textColor="#8A3F52"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Servicio 2: Tinte -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_gallery" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tinte y Color"
                        android:textColor="#2C1A1E"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="120 min - $120.000"
                        android:textColor="#8A3F52"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Servicio 3: Manicure -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/star_on" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manicure"
                        android:textColor="#2C1A1E"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 min - $35.000"
                        android:textColor="#8A3F52"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- NAVIGATION BUTTONS (Atrás y Continuar) -->
    <RelativeLayout
        android:id="@+id/layoutNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="16dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:text="Atrás"
            android:textColor="#8A3F52"
            android:background="#00000000"/>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:text="Continuar"
            android:textColor="#FFFFFF"
            android:background="#8A3F52"/>
    </RelativeLayout>

</LinearLayout>
